{
  "name": "eleven-blocks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:offline": "tsc --noEmit && vite build --config vite.offline.config.ts && node tools/pack-offline.mjs",
    "pack:offline": "node tools/pack-offline.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cek-konten": "node tools/validasi-konten.mjs"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/qrcode": "1.5.6",
    "@types/three": "0.186.0",
    "typescript": "~5.9.3",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.0.5"
  }
}
